# Copy this file to .env for Docker Compose. Never commit the real .env.
# Replace the password and JWT placeholders before starting services.
POSTGRES_PASSWORD=replace-with-your-local-database-password
REDIS_PASSWORD=
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Used when running Python outside Docker. Keep the password consistent above.
# Python reads python/.env, so copy your configured file there for local runs.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-your-local-database-password@localhost:5432/edu_agent
REDIS_URL=redis://localhost:6379/0
ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Chat model. Empty API keys allow the existing mock/template fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=
MINIMAX_API_KEY=

# RAG needs an endpoint that supports POST /v1/embeddings.
# Chat and embedding providers may be configured independently.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
